<% server_name = ENV.fetch("SERVER_NAME") { "_default_" } %>
<% unless server_name == "_default_" %>
<VirtualHost *:80>
  ServerName _default_
  DocumentRoot /var/www/html
</VirtualHost>
<% end %>

<VirtualHost *:80>
  ServerName <%= server_name %>
  DocumentRoot <%= ENV.fetch("APP_PATH") %>/public

  ProxyRequests off
  ProxyPreserveHost On

  # Allow long-running SSE chat streams (spans LLM tool-call round trips).
  # Rack::Timeout Rails 503/500 would surface; without this, mod_proxy's
  # default 300s ProxyTimeout kills chats as 502.
  ProxyTimeout 1200

  # Serve static assets directly from DocumentRoot (Apache)
  <Directory <%= ENV.fetch("APP_PATH") %>/public>
    Options -Indexes +FollowSymLinks
    AllowOverride All
    Require all granted
  </Directory>

  # Serve static assets directly using Alias
  Alias /assets /app/public/assets
  Alias /packs /app/public/packs
  Alias /favicon.ico /app/public/favicon.ico
  
  <Directory /app/public/assets>
    Options -Indexes +FollowSymLinks
    AllowOverride None
    Require all granted
  </Directory>
  <Directory /app/public/packs>
    Options -Indexes +FollowSymLinks
    AllowOverride None
    Require all granted
  </Directory>

  <% location = ENV.fetch("OPENPROJECT_RAILS__RELATIVE__URL__ROOT", "").chomp("/") %>
  <Location <%= location == "" ? "/" : location %>>
    ProxyPass http://<%= ENV.fetch("APP_HOST", "127.0.0.1") %>:8080<%= location %>/ retry=0
    ProxyPassReverse http://<%= ENV.fetch("APP_HOST", "127.0.0.1") %>:8080<%= location %>/
  </Location>

  <Location /hocuspocus>
    ProxyPass http://<%= ENV.fetch("APP_HOST", "127.0.0.1") %>:1234/ upgrade=websocket
    ProxyPassReverse http://<%= ENV.fetch("APP_HOST", "127.0.0.1") %>:1234/
  </Location>
</VirtualHost>
