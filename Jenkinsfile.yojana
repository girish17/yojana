#!/usr/bin/env groovy
/*
 * Yojana CI/CD Pipeline (Jenkins job: yojana-pipeline)
 *
 * Test -> build all-in-one linux/amd64 image -> push Docker Hub -> blue-green
 * deploy to the selected target VM -> smoke tests. Manual "Build with Parameters".
 *
 * Deploy targets:
 *   none - build + push only (default)
 *   beta - T4 GPU VM `aether-gpu-01` (yojana.matteralchemy.ai, replaces yojana-ma)
 *   prod - VM `element` (yojana.girishm.info), requires manual approval
 * For rollback: SKIP_BUILD=true + IMAGE_TAG=<previously-pushed-tag> + a target.
 *
 * Required Jenkins credentials (IDs): see docs/CI-CD-YOJANA.md
 *   github-yojana, dockerhub, yojana-azure-sp, yojana-azure-tenant
 *
 * Parameters:
 *   BRANCH          - branch to test/build/deploy (default dev)
 *   IMAGE_TAG       - override image tag (default dev-azure-<BUILD_NUM>)
 *   SKIP_TEST       - skip lint + spec + unit test stages
 *   SKIP_BUILD      - skip image build+push (use with IMAGE_TAG for rollback)
 *   DEPLOY_TARGET   - none | beta | prod (blue-green deploy to that VM)
 *   BETA_SUBSCRIPTION - Azure sub of the beta/aether tenant (SP needs RBAC on it)
 */

def deployEnv(String target) {
  switch (target) {
    case 'beta':
      return [
        "AZURE_SUBSCRIPTION=${params.BETA_SUBSCRIPTION ?: ''}",
        'AZURE_RG=aether-rg',
        'VM_NAME=aether-gpu-01',
        'HOSTNAME=yojana.matteralchemy.ai',
        'CONTAINER_NAME=yojana-v5',
      ]
    case 'prod':
      return [
        'AZURE_SUBSCRIPTION=5a1ef3e9-7b40-4163-b0ff-d0b8d2ec6e62',
        'AZURE_RG=AZUREQUANTUM',
        'VM_NAME=element',
        'HOSTNAME=yojana.girishm.info',
        'CONTAINER_NAME=yojana-v5',
      ]
    default:
      return []
  }
}

def targetUrl(String target) {
  target == 'prod' ? 'https://yojana.girishm.info' : 'https://yojana.matteralchemy.ai'
}

def deployCredentials(String target) {
  if (target == 'beta') {
    return [
      usernamePassword(credentialsId: 'yojana-azure-sp-beta',
                       usernameVariable: 'AZ_CLIENT_ID',
                       passwordVariable: 'AZ_CLIENT_SECRET'),
      string(credentialsId: 'yojana-azure-tenant-beta', variable: 'AZ_TENANT_ID')
    ]
  }
  return [
    usernamePassword(credentialsId: 'yojana-azure-sp',
                     usernameVariable: 'AZ_CLIENT_ID',
                     passwordVariable: 'AZ_CLIENT_SECRET'),
    string(credentialsId: 'yojana-azure-tenant', variable: 'AZ_TENANT_ID')
  ]
}

pipeline {
    agent any
    options {
        disableConcurrentBuilds()
        timestamps()
        timeout(time: 360, unit: 'MINUTES')
    }

    parameters {
        string(name: 'BRANCH', defaultValue: 'dev',
               description: 'Branch to test/build/deploy.')
        string(name: 'IMAGE_TAG', defaultValue: '',
               description: 'Override image tag (default: dev-azure-<BUILD_NUM>). For rollback, pass a previously-pushed tag with SKIP_BUILD=true.')
        booleanParam(name: 'SKIP_TEST', defaultValue: false,
               description: 'Skip lint + spec + unit test stages.')
        booleanParam(name: 'SKIP_BUILD', defaultValue: false,
               description: 'Skip image build+push (deploy an existing tag).')
        choice(name: 'DEPLOY_TARGET', choices: ['none', 'beta', 'prod'],
               description: "Deploy after build. none = build+push only (default). beta = T4 GPU VM `aether-gpu-01` (yojana.matteralchemy.ai). prod = VM `element` (yojana.girishm.info, manual approval). Rollback: SKIP_BUILD=true + IMAGE_TAG + target.")
        string(name: 'BETA_SUBSCRIPTION', defaultValue: '',
               description: 'Azure subscription id of the beta/aether sub. The `yojana-azure-sp` principal must have RBAC (Contributor) on it for beta deploys.')
    }

    environment {
        REPO = 'https://github.com/girish17/yojana.git'
        BRANCH = "${params.BRANCH}"
        IMAGE_TAG = "${params.IMAGE_TAG ?: 'dev-azure-' + env.BUILD_NUMBER}"
        IMAGE_BASE = 'girish17/yojana'
        NOTIFY_EMAIL = 'm.girish.cs@gmail.com'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout([$class: 'GitSCM',
                    branches: [[name: BRANCH]],
                    userRemoteConfigs: [[url: REPO,
                        credentialsId: 'github-yojana']],
                    extensions: [[$class: 'CleanBeforeCheckout']]])
            }
        }

        stage('Setup CI env') {
            when { expression { !params.SKIP_TEST } }
            steps {
                sh 'CI_JOBS=2 ./scripts/ci/ci-run.sh setup-tests'
            }
        }

        stage('Lint') {
            when { expression { !params.SKIP_TEST } }
            steps {
                sh '''git fetch origin --quiet 2>/dev/null || true
                      CHANGED="$(git diff --name-only $(git rev-parse HEAD~1 2>/dev/null || echo HEAD) HEAD 2>/dev/null | grep -E '\\.rb$' || true)"
                      if [ -z "$CHANGED" ]; then
                        echo "No Ruby files changed in this commit - skipping rubocop."
                      else
                        CI_JOBS=2 ./scripts/ci/ci-run.sh bundle exec rubocop --force-exclusion $CHANGED
                      fi'''
            }
        }

        stage('Spec (webhook auth)') {
            when { expression { !params.SKIP_TEST } }
            steps {
                sh 'CI_JOBS=1 ./scripts/ci/ci-run.sh bash -c "reset_dbs && bundle exec rspec spec/controllers/application_controller_spec.rb"'
            }
        }

        stage('Unit tests') {
            when { expression { !params.SKIP_TEST } }
            steps {
                sh 'CI_JOBS=2 ./scripts/ci/ci-run.sh run-units'
            }
        }

        stage('Build image') {
            when { expression { !params.SKIP_BUILD } }
            steps {
                withCredentials([usernamePassword(credentialsId: 'dockerhub',
                                     usernameVariable: 'DH_USER',
                                     passwordVariable: 'DH_PASS')]) {
                    sh '''echo "$DH_PASS" | docker login -u "$DH_USER" --password-stdin
                          docker buildx build --push \
                            --platform linux/amd64 \
                            -t ${IMAGE_BASE}:${IMAGE_TAG} \
                            -t ${IMAGE_BASE}:dev-azure \
                            --target all-in-one -f docker/prod/Dockerfile .'''
                }
            }
        }

        stage('Approve deploy') {
            when { expression { params.DEPLOY_TARGET == 'prod' } }
            steps {
                script {
                    input message: "Deploy ${IMAGE_TAG} to yojana.girishm.info? (rollback mode: ${params.SKIP_BUILD})",
                          ok: 'Deploy to production'
                }
            }
        }

        stage('Deploy blue-green') {
            when { expression { params.DEPLOY_TARGET == 'beta' || params.DEPLOY_TARGET == 'prod' } }
            steps {
                script {
                    def targetEnv = deployEnv(params.DEPLOY_TARGET)
                    if (params.DEPLOY_TARGET == 'beta' && (!params.BETA_SUBSCRIPTION?.trim())) {
                        error "BETA_SUBSCRIPTION parameter is required for beta deploys (SP needs RBAC on that sub)."
                    }
                    withCredentials(deployCredentials(params.DEPLOY_TARGET)) {
                        withEnv(targetEnv) {
                            sh 'bash scripts/ci/deploy-yojana.sh $IMAGE_TAG'
                        }
                    }
                }
            }
        }

        stage('Smoke tests') {
            when { expression { params.DEPLOY_TARGET == 'beta' || params.DEPLOY_TARGET == 'prod' } }
            steps {
                sh "bash scripts/ci/smoke-test.sh ${targetUrl(params.DEPLOY_TARGET)}"
            }
        }
    }

    post {
        success {
            echo "Yojana ${env.BUILD_NUMBER} succeeded (image ${IMAGE_TAG})."
            script {
                try {
                    mail to: NOTIFY_EMAIL,
                         subject: "Yojana ${env.BUILD_NUMBER} SUCCESS (${BRANCH})",
                         body: "Build ${currentBuild.absoluteUrl}\nBranch: ${BRANCH}\nImage: ${IMAGE_TAG}\nResult: ${currentBuild.currentResult}\n${currentBuild.absoluteUrl}console"
                } catch (e) { echo "Failed to send success email: ${e}" }
            }
        }
        failure {
            echo "Yojana ${env.BUILD_NUMBER} failed - rollback guidance: docs/CI-CD-YOJANA.md"
            script {
                try {
                    mail to: NOTIFY_EMAIL,
                         subject: "Yojana ${env.BUILD_NUMBER} FAILURE (${BRANCH})",
                         body: "Build ${currentBuild.absoluteUrl}\nBranch: ${BRANCH}\nImage: ${IMAGE_TAG}\nResult: ${currentBuild.currentResult}\n${currentBuild.absoluteUrl}console"
                } catch (e) { echo "Failed to send failure email: ${e}" }
            }
        }
    }
}